{
  "name": "h2-schedule",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:phone": "tsc -b && vite build --config vite.phone.config.ts && node scripts/make-ota.mjs",
    "build:apk": "npm run build:phone && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "build:pages": "node scripts/publish-docs.mjs",
    "campus": "python scripts/campus_sync_server.py",
    "check:schedule": "node scripts/check-schedule.mjs",
    "check:logic": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-logic.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
